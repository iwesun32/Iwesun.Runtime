{
  "pipeName": "DdnsSnap.RuntimeDiagnostics",
  "webPipeName": "AIGateway.WebRuntime",
  "memoryEnvironmentVariable": "IWESUN_CLI_MEMORY",
  "defaultMemory": "ddnssnap",
  "pipeSlots": [ "N1", "N2", "N3", "N4", "N5", "N6", "N7", "N8", "N9", "N10", "N11", "N12", "N13", "N14", "N15", "N16" ],
  "memories": [
    {
      "name": "ddnssnap",
      "values": {
        "N1.diagnosticsPipeName": "DdnsSnap.RuntimeDiagnostics",
        "N1.webRuntimePipeName": "AIGateway.WebRuntime",
        "N1.managementPipeName": "DdnsSnap.Service.Ui",
        "N2.diagnosticsPipeName": "DdnsSnap.RuntimeDiagnostics",
        "N2.webRuntimePipeName": "AIGateway.WebRuntime",
        "N2.managementPipeName": "DdnsSnap.Service.Ui",
        "diagnosticsPipeName": "DdnsSnap.RuntimeDiagnostics",
        "webRuntimePipeName": "AIGateway.WebRuntime",
        "managementPipeName": "DdnsSnap.Service.Ui",
        "targetId": "diagnostics.switchboard",
        "section": "runtime.diagnostics",
        "count": 100,
        "durationMs": 500,
        "includeOuterHtml": true,
        "maxHtmlChars": 4000
      }
    },
    {
      "name": "aigateway",
      "values": {
        "N1.diagnosticsPipeName": "AIGateway.RuntimeDiagnostics",
        "N1.webRuntimePipeName": "AIGateway.WebRuntime",
        "N1.managementPipeName": "AIGateway.UI",
        "diagnosticsPipeName": "AIGateway.RuntimeDiagnostics",
        "webRuntimePipeName": "AIGateway.WebRuntime",
        "managementPipeName": "AIGateway.UI",
        "backendId": "doubao-web",
        "targetId": "diagnostics.switchboard",
        "section": "runtime.diagnostics",
        "count": 100,
        "durationMs": 500,
        "includeOuterHtml": true,
        "maxHtmlChars": 4000
      }
    }
  ],
  "transports": {
    "diagnostics": {
      "kind": "runtime-diagnostics",
      "pipeName": "DdnsSnap.RuntimeDiagnostics"
    },
    "webview2": {
      "kind": "web-runtime",
      "pipeName": "AIGateway.WebRuntime"
    },
    "management": {
      "kind": "json-pipe",
      "pipeName": "DdnsSnap.Service.Ui"
    },
    "agent": {
      "kind": "json-pipe",
      "pipeName": "DdnsSnap.Agent.Ui"
    },
    "desktop-ui": {
      "kind": "json-pipe",
      "pipeName": "LOCAL\\DdnsSnap.UI"
    }
  },
  "help": {
    "title": "Iwesun runtime CLI",
    "usage": "iwrt [--config=path] [--pipe=name] [--web-pipe=name] <command>",
    "footer": "Use short aliases when possible: s, l, e, q, w."
  },
  "commands": [
    { "name": "status", "aliases": [ "s" ], "pattern": "^(?:s|status)$", "kind": "builtin", "builtin": "status", "help": "Monitor, switchboard, and target summary." },
    { "name": "memory", "aliases": [ "mem" ], "pattern": "^(?:mem|memory)(?<tail>.*)$", "kind": "builtin", "builtin": "memory", "help": "Show or edit current CLI memory slot." },
    { "name": "quiet", "aliases": [ "q" ], "pattern": "^(?:q|quiet)$", "kind": "builtin", "builtin": "quiet", "help": "Disable enabled points, sections, global, pipe, and file." },
    { "name": "focus-point", "aliases": [ "fp", "focus" ], "pattern": "^(?:fp|focus|focus-point)\\s+(?<id>\\S+)$", "captures": { "args.id": "id" }, "kind": "builtin", "builtin": "focus-point", "help": "Open pipe, global, section, and point." },
    { "name": "focus-text", "aliases": [ "ft" ], "pattern": "^(?:ft|focus-text)\\s+(?<text>.+)$", "captures": { "args.text": "text" }, "kind": "builtin", "builtin": "focus-text", "help": "Focus the only point matching text." },
    { "name": "focus-section", "aliases": [ "fs" ], "pattern": "^(?:fs|focus-section)\\s+(?<section>\\S+)$", "captures": { "args.section": "section" }, "kind": "builtin", "builtin": "focus-section", "help": "Open pipe, global, and one section." },
    { "name": "focus-section-points", "aliases": [ "fsp" ], "pattern": "^(?:fsp|focus-section-points)\\s+(?<section>\\S+)$", "captures": { "args.section": "section" }, "kind": "builtin", "builtin": "focus-section-points", "help": "Open pipe, global, section, and all section points." },

    { "name": "snapshot", "aliases": [ "ss" ], "pattern": "^(?:ss|snapshot)(?:\\s+(?<targetId>\\S+))?$", "captures": { "targetId": "targetId" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "snapshot", "positionals": { "targetId": 0 }, "memory": { "targetId": "targetId" }, "remember": { "targetId": "targetId" }, "help": "Snapshot diagnostics.switchboard or one target." },
    { "name": "monitor", "aliases": [ "m" ], "pattern": "^(?:m|monitor)$", "kind": "diagnostics", "targetId": "diagnostics.monitor", "action": "snapshot", "help": "Snapshot diagnostics.monitor." },
    { "name": "list", "aliases": [ "l" ], "pattern": "^(?:l|list)$", "kind": "diagnostics", "action": "list", "help": "List registered runtime targets." },
    { "name": "host", "aliases": [ "ho" ], "pattern": "^(?:ho|host)$", "kind": "diagnostics", "action": "host", "help": "Read runtime host scan." },
    { "name": "rescan-host", "aliases": [ "rh" ], "pattern": "^(?:rh|rescan-host|rescanHost)$", "kind": "diagnostics", "action": "rescanHost", "help": "Rescan runtime host information." },
    { "name": "events", "aliases": [ "e" ], "pattern": "^(?:e|events)(?:\\s+(?<count>\\d+))?(?<tail>.*)$", "captures": { "args.count": "count" }, "kind": "diagnostics", "action": "events", "namedArgs": true, "positionals": { "args.count": 0 }, "memory": { "args.count": "count" }, "remember": { "args.count": "count" }, "help": "Drain runtime events." },
    { "name": "events-clean", "aliases": [ "ec" ], "pattern": "^(?:ec|events-clean)(?:\\s+(?<count>\\d+))?$", "captures": { "args.count": "count" }, "kind": "diagnostics", "action": "events", "namedArgs": true, "args": { "excludeKinds": "command,switch" }, "positionals": { "args.count": 0 }, "memory": { "args.count": "count" }, "remember": { "args.count": "count" }, "help": "Drain events excluding command and switch." },
    { "name": "points", "aliases": [ "ps" ], "pattern": "^(?:ps|points)(?<tail>.*)$", "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "queryPoints", "namedArgs": true, "memory": { "args.section": "section", "args.category": "category", "args.text": "text" }, "remember": { "args.section": "section", "args.category": "category", "args.text": "text" }, "help": "Query monitor-point catalog." },
    { "name": "point", "aliases": [ "p" ], "pattern": "^(?:p|point)\\s+(?<id>\\S+)$", "captures": { "args.id": "id" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "queryPoints", "positionals": { "args.id": 0 }, "memory": { "args.id": "outputPointId" }, "remember": { "args.id": "outputPointId" }, "help": "Query one output point." },
    { "name": "reload-config", "aliases": [ "rc", "reload" ], "pattern": "^(?:rc|reload|reload-config|reloadConfig)$", "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "reloadConfig", "help": "Reload diagnostic switchboard config." },
    { "name": "save-config", "aliases": [ "sc", "save" ], "pattern": "^(?:sc|save|save-config|saveConfig)$", "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "saveConfig", "help": "Persist diagnostic switchboard config." },
    { "name": "input", "aliases": [ "in", "set-input" ], "pattern": "^(?:in|input|set-input)\\s+(?<enabled>\\S+)(?<tail>.*)$", "captures": { "args.enabled": "enabled" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "setInput", "namedArgs": true, "positionals": { "args.enabled": 0 }, "help": "Enable or disable diagnostics input." },
    { "name": "pipe", "aliases": [ "pi", "set-pipe" ], "pattern": "^(?:pi|pipe|set-pipe)\\s+(?<enabled>\\S+)$", "captures": { "args.enabled": "enabled" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "setPipeOutput", "positionals": { "args.enabled": 0 }, "help": "Enable or disable live pipe output." },
    { "name": "file", "aliases": [ "fi", "set-file" ], "pattern": "^(?:fi|file|set-file)\\s+(?<enabled>\\S+)$", "captures": { "args.enabled": "enabled" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "setFileOutput", "positionals": { "args.enabled": 0 }, "help": "Enable or disable diagnostic file output." },
    { "name": "file-path", "aliases": [ "fpath", "set-file-path" ], "pattern": "^(?:fpath|file-path|set-file-path)\\s+(?<path>.+)$", "captures": { "args.path": "path" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "setFilePath", "positionals": { "args.path": 0 }, "help": "Set diagnostic output file path." },
    { "name": "fifo-depth", "aliases": [ "fd", "set-fifo-depth" ], "pattern": "^(?:fd|fifo-depth|set-fifo-depth)\\s+(?<depth>\\d+)$", "captures": { "args.depth": "depth" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "setFifoDepth", "positionals": { "args.depth": 0 }, "help": "Set diagnostics event FIFO depth." },
    { "name": "diagnostics-pipe", "aliases": [ "dpi", "set-diagnostics-pipe" ], "pattern": "^(?:dpi|diagnostics-pipe|set-diagnostics-pipe)\\s+(?<name>\\S+)(?<tail>.*)$", "captures": { "args.name": "name" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "setDiagnosticsPipeName", "namedArgs": true, "positionals": { "args.name": 0 }, "remember": { "args.name": "diagnosticsPipeName" }, "help": "Set runtime diagnostics pipe name." },
    { "name": "web-pipe", "aliases": [ "wpi", "set-web-pipe" ], "pattern": "^(?:wpi|web-pipe|set-web-pipe)\\s+(?<name>\\S+)(?<tail>.*)$", "captures": { "args.name": "name" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "setWebPipeName", "namedArgs": true, "positionals": { "args.name": 0 }, "remember": { "args.name": "webRuntimePipeName" }, "help": "Set WebRuntime pipe name." },
    { "name": "management-pipe", "aliases": [ "mpi", "set-management-pipe" ], "pattern": "^(?:mpi|management-pipe|set-management-pipe)\\s+(?<name>\\S+)(?<tail>.*)$", "captures": { "args.name": "name" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "setManagementPipeName", "namedArgs": true, "positionals": { "args.name": 0 }, "remember": { "args.name": "managementPipeName" }, "help": "Set Desktop-Service management pipe name; restart service to listen on it." },
    { "name": "enable", "aliases": [ "en" ], "pattern": "^(?:en|enable)(?:\\s+(?<section>\\S+))?$", "captures": { "args.section": "section" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "enable", "positionals": { "args.section": 0 }, "memory": { "args.section": "section" }, "remember": { "args.section": "section" }, "help": "Enable global or one section." },
    { "name": "disable", "aliases": [ "dis" ], "pattern": "^(?:dis|disable)(?:\\s+(?<section>\\S+))?$", "captures": { "args.section": "section" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "disable", "positionals": { "args.section": 0 }, "memory": { "args.section": "section" }, "remember": { "args.section": "section" }, "help": "Disable global or one section." },
    { "name": "set-global", "aliases": [ "sg" ], "pattern": "^(?:sg|set-global)\\s+(?<enabled>\\S+)(?<tail>.*)$", "captures": { "args.enabled": "enabled" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "set", "namedArgs": true, "positionals": { "args.enabled": 0 }, "help": "Set global diagnostics enabled state." },
    { "name": "set-section", "aliases": [ "ssn" ], "pattern": "^(?:ssn|set-section)\\s+(?<section>\\S+)\\s+(?<enabled>\\S+)(?<tail>.*)$", "captures": { "args.section": "section", "args.enabled": "enabled" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "set", "namedArgs": true, "positionals": { "args.section": 0, "args.enabled": 1 }, "help": "Set one diagnostics section enabled state." },
    { "name": "enable-point", "aliases": [ "ep" ], "pattern": "^(?:ep|enable-point)\\s+(?<id>\\S+)$", "captures": { "args.id": "id" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "enablePoint", "positionals": { "args.id": 0 }, "memory": { "args.id": "outputPointId" }, "remember": { "args.id": "outputPointId" }, "help": "Enable one output point." },
    { "name": "disable-point", "aliases": [ "dp" ], "pattern": "^(?:dp|disable-point)\\s+(?<id>\\S+)$", "captures": { "args.id": "id" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "disablePoint", "positionals": { "args.id": 0 }, "memory": { "args.id": "outputPointId" }, "remember": { "args.id": "outputPointId" }, "help": "Disable one output point." },
    { "name": "set-point", "aliases": [ "sp" ], "pattern": "^(?:sp|set-point)\\s+(?<id>\\S+)\\s+(?<enabled>\\S+)(?<tail>.*)$", "captures": { "args.id": "id", "args.enabled": "enabled" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "setPoint", "namedArgs": true, "positionals": { "args.id": 0, "args.enabled": 1 }, "help": "Set one output point enabled state." },
    { "name": "invoke", "aliases": [ "i" ], "pattern": "^(?:i|invoke)\\s+(?<targetId>\\S+)\\s+(?<member>\\S+)$", "captures": { "targetId": "targetId", "member": "member" }, "kind": "diagnostics", "action": "invoke", "positionals": { "targetId": 0, "member": 1 }, "memory": { "targetId": "targetId", "member": "member" }, "remember": { "targetId": "targetId", "member": "member" }, "help": "Invoke a whitelisted member." },
    { "name": "get", "aliases": [ "g" ], "pattern": "^(?:g|get)\\s+(?<targetId>\\S+)\\s+(?<member>\\S+)$", "captures": { "targetId": "targetId", "member": "member" }, "kind": "diagnostics", "action": "get", "positionals": { "targetId": 0, "member": 1 }, "memory": { "targetId": "targetId", "member": "member" }, "remember": { "targetId": "targetId", "member": "member" }, "help": "Read one reflected member." },
    { "name": "set", "aliases": [ "se" ], "pattern": "^(?:se|set)\\s+(?<targetId>\\S+)\\s+(?<member>\\S+)\\s+(?<value>.+)$", "captures": { "targetId": "targetId", "member": "member", "value": "value" }, "kind": "diagnostics", "action": "set", "positionals": { "targetId": 0, "member": 1, "value": 2 }, "memory": { "targetId": "targetId", "member": "member" }, "remember": { "targetId": "targetId", "member": "member" }, "help": "Set one whitelisted reflected member." },
    { "name": "emit", "aliases": [ "em" ], "pattern": "^(?:em|emit)(?:\\s+(?<section>\\S+))?(?:\\s+(?<kind>\\S+))?(?:\\s+(?<message>.+))?$", "captures": { "args.section": "section", "args.kind": "kind", "args.message": "message" }, "kind": "diagnostics", "targetId": "diagnostics.switchboard", "action": "emitTest", "positionals": { "args.section": 0, "args.kind": 1, "args.message": 2 }, "joinFrom": 2, "help": "Emit a self-test diagnostic event." },
    { "name": "doubao-upload-image", "aliases": [ "dbimg", "dbup" ], "pattern": "^(?:dbimg|dbup|doubao-upload-image)(?<tail>.*)$", "kind": "diagnostics", "targetId": "adapter.doubao-web", "action": "uploadImageAttachment", "namedArgs": true, "memory": { "args.local_file_path": "localFilePath", "args.prompt": "prompt", "args.model": "model" }, "remember": { "args.local_file_path": "localFilePath", "args.prompt": "prompt", "args.model": "model" }, "help": "Upload a local image through Doubao ImageX/TOS and send it as a chat attachment. Use --local_file_path=... --prompt=..." },
    { "name": "doubao-history-list", "aliases": [ "dbhist" ], "pattern": "^(?:dbhist|doubao-history-list)(?<tail>.*)$", "kind": "diagnostics", "targetId": "adapter.doubao-web", "action": "historyList", "namedArgs": true, "memory": { "args.limit": "historyLimit" }, "remember": { "args.limit": "historyLimit" }, "help": "List Doubao remote history cached/refreshed by the adapter. Use --limit=20." },
    { "name": "doubao-open-conversation", "aliases": [ "dbconvopen" ], "pattern": "^(?:dbconvopen|doubao-open-conversation)(?<tail>.*)$", "kind": "diagnostics", "targetId": "adapter.doubao-web", "action": "openConversation", "namedArgs": true, "memory": { "args.session_id": "sessionId" }, "remember": { "args.session_id": "sessionId" }, "help": "Open a Doubao history conversation by session id. Use --session_id=... ." },
    { "name": "doubao-list-documents", "aliases": [ "dbdoclist", "dbdocs" ], "pattern": "^(?:dbdoclist|dbdocs|doubao-list-documents|doubao-scan-documents)(?<tail>.*)$", "kind": "diagnostics", "targetId": "adapter.doubao-web", "action": "listDocuments", "namedArgs": true, "memory": { "args.session_id": "sessionId", "args.max_text_chars": "maxTextChars" }, "remember": { "args.session_id": "sessionId", "args.max_text_chars": "maxTextChars" }, "help": "Open an optional Doubao history session and list generated document cards. Use --session_id=... ." },
    { "name": "doubao-open-document", "aliases": [ "dbdocopen" ], "pattern": "^(?:dbdocopen|doubao-open-document)(?<tail>.*)$", "kind": "diagnostics", "targetId": "adapter.doubao-web", "action": "openDocument", "namedArgs": true, "memory": { "args.session_id": "sessionId", "args.title": "documentTitle", "args.document_index": "documentIndex", "args.document_key": "documentKey" }, "remember": { "args.session_id": "sessionId", "args.title": "documentTitle", "args.document_index": "documentIndex", "args.document_key": "documentKey" }, "help": "Open a generated Doubao document from a history conversation. Use --session_id=... --title=..., --document_key=..., or --document_index=0." },
    { "name": "doubao-download-current-document", "aliases": [ "dbdocdl" ], "pattern": "^(?:dbdocdl|doubao-download-current-document)(?<tail>.*)$", "kind": "diagnostics", "targetId": "adapter.doubao-web", "action": "downloadDocument", "namedArgs": true, "memory": { "args.format": "documentFormat", "args.downloads_dir": "downloadDir" }, "remember": { "args.format": "documentFormat", "args.downloads_dir": "downloadDir" }, "help": "Download the currently opened Doubao generated document. Use --format=word|pdf|markdown." },
