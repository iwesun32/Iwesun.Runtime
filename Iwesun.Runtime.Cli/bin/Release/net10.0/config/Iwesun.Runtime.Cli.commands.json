    { "name": "doubao-download-document-by-id", "aliases": [ "dbdocget" ], "pattern": "^(?:dbdocget|doubao-download-document-by-id)(?<tail>.*)$", "kind": "diagnostics", "targetId": "adapter.doubao-web", "action": "downloadDocumentById", "namedArgs": true, "memory": { "args.id": "documentId", "args.format": "documentFormat", "args.output_dir": "downloadDir" }, "remember": { "args.id": "documentId", "args.format": "documentFormat", "args.output_dir": "downloadDir" }, "help": "Open and download a registered Doubao document by managed id or resolved docId. Use --id=dbdoc_xxx --format=word|pdf|markdown." },
