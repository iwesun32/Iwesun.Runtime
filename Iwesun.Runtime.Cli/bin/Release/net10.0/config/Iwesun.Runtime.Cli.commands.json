    { "name": "agent-config", "aliases": [ "agc" ], "pattern": "^(?:agc|agent-config)$", "transport": "agent", "request": { "header": { "protocol": "ddnssnap.interaction.v1", "operation": "configuration.push", "intent": "query", "target": "agent.configuration", "source": "iwesun-runtime-cli" } }, "help": "Read Agent configuration through the unified interaction command pipe." },
