{
  "schema": "iwesun.runtime.cli/3.0",
  "application": { "name": "Iwesun Runtime CLI v3", "description": "Runtime diagnostics command client" },
  "endpoints": {
    "diagnostics": { "transport": "namedPipe", "pipeName": "DdnsSnap.RuntimeDiagnostics", "connectTimeoutMs": 5000, "requestTimeoutMs": 15000, "maxResponseBytes": 16777216 }
  },
  "commands": [
    { "name":"host.info", "endpoint":"diagnostics", "request":{"category":"query","operation":"get","domain":"host","target":"diagnostics.host","action":"info"} },
    { "name":"host.events", "endpoint":"diagnostics", "request":{"category":"query","operation":"list","domain":"host","target":"diagnostics.host","action":"events"}, "parameters":[{"name":"maxCount","type":"int32","position":0,"required":false,"default":100}] },
    { "name":"lifecycle.status", "endpoint":"diagnostics", "request":{"category":"query","operation":"get","domain":"lifecycle","target":"runtime.lifecycle","action":"status"} },
    { "name":"lifecycle.shutdown", "endpoint":"diagnostics", "request":{"category":"instruction","operation":"shutdown","domain":"lifecycle","target":"diagnostics.switchboard","action":"shutdown"}, "parameters":[{"name":"graceful","type":"bool","position":0,"required":false,"default":true}] },
    { "name":"switchboard.get", "endpoint":"diagnostics", "request":{"category":"query","operation":"get","domain":"switchboard","target":"diagnostics.switchboard","action":"snapshot"} },
    { "name":"switchboard.enable", "endpoint":"diagnostics", "request":{"category":"instruction","operation":"enable","domain":"switchboard","target":"diagnostics.switchboard","action":"enable"}, "parameters":[{"name":"section","type":"string","position":0,"required":false}] },
    { "name":"switchboard.disable", "endpoint":"diagnostics", "request":{"category":"instruction","operation":"disable","domain":"switchboard","target":"diagnostics.switchboard","action":"disable"}, "parameters":[{"name":"section","type":"string","position":0,"required":false}] },
    { "name":"breakpoint.list", "endpoint":"diagnostics", "request":{"category":"query","operation":"list","domain":"breakpoint","target":"diagnostics.breakpoints","action":"list"} },
    { "name":"breakpoint.enable", "endpoint":"diagnostics", "request":{"category":"instruction","operation":"enable","domain":"breakpoint","target":"diagnostics.breakpoints","action":"enable"}, "parameters":[{"name":"id","type":"string","position":0,"required":true}] },
    { "name":"breakpoint.disable", "endpoint":"diagnostics", "request":{"category":"instruction","operation":"disable","domain":"breakpoint","target":"diagnostics.breakpoints","action":"disable"}, "parameters":[{"name":"id","type":"string","position":0,"required":true}] },
    { "name":"breakpoint.resume", "endpoint":"diagnostics", "request":{"category":"instruction","operation":"resume","domain":"breakpoint","target":"diagnostics.breakpoints","action":"resume"}, "parameters":[{"name":"id","type":"string","position":0,"required":true}] },
    { "name":"hook.list", "endpoint":"diagnostics", "request":{"category":"query","operation":"list","domain":"hook","target":"diagnostics.hooks","action":"list"} },
    { "name":"registry.list", "endpoint":"diagnostics", "request":{"category":"query","operation":"list","domain":"registry","target":"diagnostics.registry","action":"list"} },
    { "name":"process.list", "endpoint":"diagnostics", "request":{"category":"query","operation":"list","domain":"process","target":"runtime.execution","action":"processes"} },
    { "name":"thread.list", "endpoint":"diagnostics", "request":{"category":"query","operation":"list","domain":"thread","target":"runtime.execution","action":"threads"} },
    { "name":"task.list", "endpoint":"diagnostics", "request":{"category":"query","operation":"list","domain":"task","target":"runtime.execution","action":"tasks"} },
    { "name":"pipe.list", "endpoint":"diagnostics", "request":{"category":"query","operation":"list","domain":"pipe","target":"diagnostics.pipes","action":"list"} },
    { "name":"pipe.acquire", "endpoint":"diagnostics", "request":{"category":"instruction","operation":"register","domain":"pipe","target":"diagnostics.pipes","action":"acquire"}, "parameters":[{"name":"requestedPipeName","type":"string","position":0,"required":true},{"name":"aggregatePipeName","type":"string","position":1,"required":false}] },
    { "name":"pipe.resolve", "endpoint":"diagnostics", "request":{"category":"query","operation":"get","domain":"pipe","target":"diagnostics.pipes","action":"resolve"}, "parameters":[{"name":"requestedPipeName","type":"string","position":0,"required":true}] },
    { "name":"file.list", "endpoint":"diagnostics", "request":{"category":"query","operation":"list","domain":"file","target":"diagnostics.files","action":"list"} },
    { "name":"reflection.list", "endpoint":"diagnostics", "request":{"category":"query","operation":"list","domain":"reflection","target":"diagnostics.registry","action":"list"} },
    { "name":"reflection.get", "endpoint":"diagnostics", "request":{"category":"query","operation":"get","domain":"reflection","target":"diagnostics.reflection","action":"get"}, "parameters":[{"name":"target","type":"string","position":0,"required":true},{"name":"member","type":"string","position":1,"required":false}] },
    { "name":"web.snapshot", "endpoint":"diagnostics", "request":{"category":"query","operation":"invoke","domain":"web","target":"diagnostics.proxy","action":"invoke"}, "parameters":[{"name":"backendId","type":"string","position":0,"required":true}] }
  ],
  "workflows": [],
  "extensions": {}
}
