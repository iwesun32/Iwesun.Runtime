{
  "version": 2,
  "meta": {
    "name": "Iwesun Runtime CLI (Unified V2)",
    "description": "Configurable command interface for runtime diagnostics, with JSON pipe commands and PowerShell-style command aliases"
  },
  "pipes": {
    "diagnostics": "DdnsSnap.RuntimeDiagnostics"
  },
  "memory": {
    "section": "runtime.diagnostics",
    "count": "100"
  },
  "baseCommands": [
    {
      "name": "sw.list",
      "aliases": ["sw.ls", "sw-list"],
      "help": "Snapshot switchboard state",
      "usage": "sw.list",
      "examples": ["sw.list", "sw-list"],
      "transport": "diagnostics",
      "category": "query",
      "operation": "list",
      "targetId": "diagnostics.switchboard",
      "action": "snapshot"
    },
    {
      "name": "sw.enable",
      "aliases": ["sw.on", "sw-enable"],
      "help": "Enable global or one section",
      "usage": "sw.enable [section]",
      "examples": ["sw.enable", "sw.enable runtime.diagnostics", "sw-enable runtime.diagnostics"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "enable",
      "targetId": "diagnostics.switchboard",
      "action": "enable",
      "params": {
        "section": { "type": "string", "position": 0, "required": false }
      }
    },
    {
      "name": "sw.disable",
      "aliases": ["sw.off", "sw-disable"],
      "help": "Disable global or one section",
      "usage": "sw.disable [section]",
      "examples": ["sw.disable", "sw.disable runtime.diagnostics", "sw-disable runtime.diagnostics"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "disable",
      "targetId": "diagnostics.switchboard",
      "action": "disable",
      "params": {
        "section": { "type": "string", "position": 0, "required": false }
      }
    },
    {
      "name": "sw.pipe",
      "aliases": ["sw.pipe.set", "sw-pipe"],
      "help": "Set pipe output true/false",
      "usage": "sw.pipe <true|false>",
      "examples": ["sw.pipe true", "sw-pipe false"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "set",
      "targetId": "diagnostics.switchboard",
      "action": "setPipeOutput",
      "params": {
        "enabled": { "type": "bool", "position": 0, "required": true }
      }
    },
    {
      "name": "sw.file",
      "aliases": ["sw.file.set", "sw-file"],
      "help": "Set file output true/false",
      "usage": "sw.file <true|false>",
      "examples": ["sw.file true", "sw-file false"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "set",
      "targetId": "diagnostics.switchboard",
      "action": "setFileOutput",
      "params": {
        "enabled": { "type": "bool", "position": 0, "required": true }
      }
    },
    {
      "name": "sw.points",
      "aliases": ["sw.ps", "sw-points"],
      "help": "Query output points",
      "usage": "sw.points [section] [text]",
      "examples": ["sw.points", "sw.points runtime.diagnostics", "sw-points runtime.diagnostics trace"],
      "transport": "diagnostics",
      "category": "query",
      "operation": "list",
      "targetId": "diagnostics.switchboard",
      "action": "queryPoints",
      "params": {
        "section": { "type": "string", "required": false },
        "text": { "type": "string", "required": false }
      }
    },
    {
      "name": "sw.point.enable",
      "aliases": ["sw.pe", "sw-point-enable"],
      "help": "Enable one output point",
      "usage": "sw.point.enable <id>",
      "examples": ["sw.point.enable op-001", "sw-point-enable op-001"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "enable",
      "targetId": "diagnostics.switchboard",
      "action": "enablePoint",
      "params": {
        "id": { "type": "string", "position": 0, "required": true }
      }
    },
    {
      "name": "sw.point.disable",
      "aliases": ["sw.pd", "sw-point-disable"],
      "help": "Disable one output point",
      "usage": "sw.point.disable <id>",
      "examples": ["sw.point.disable op-001", "sw-point-disable op-001"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "disable",
      "targetId": "diagnostics.switchboard",
      "action": "disablePoint",
      "params": {
        "id": { "type": "string", "position": 0, "required": true }
      }
    },
    {
      "name": "bp.list",
      "aliases": ["bp.ls", "bp-list"],
      "help": "List all breakpoints",
      "usage": "bp.list",
      "examples": ["bp.list", "bp-list"],
      "transport": "diagnostics",
      "category": "query",
      "operation": "list",
      "targetId": "diagnostics.breakpoints",
      "action": "list"
    },
    {
      "name": "bp.enable",
      "aliases": ["bp.on", "bp-enable"],
      "help": "Enable breakpoint",
      "usage": "bp.enable <id>",
      "examples": ["bp.enable bp-001", "bp-enable bp-001"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "enable",
      "targetId": "diagnostics.breakpoints",
      "action": "enable",
      "params": {
        "id": { "type": "string", "position": 0, "required": true }
      }
    },
    {
      "name": "bp.disable",
      "aliases": ["bp.off", "bp-disable"],
      "help": "Disable breakpoint",
      "usage": "bp.disable <id>",
      "examples": ["bp.disable bp-001", "bp-disable bp-001"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "disable",
      "targetId": "diagnostics.breakpoints",
      "action": "disable",
      "params": {
        "id": { "type": "string", "position": 0, "required": true }
      }
    },
    {
      "name": "bp.resume",
      "aliases": ["bp.go", "bp-resume"],
      "help": "Resume one paused breakpoint",
      "usage": "bp.resume <id>",
      "examples": ["bp.resume bp-001", "bp-resume bp-001"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "resume",
      "targetId": "diagnostics.breakpoints",
      "action": "resume",
      "params": {
        "id": { "type": "string", "position": 0, "required": true }
      }
    },
    {
      "name": "bp.resume-all",
      "aliases": ["bp.goall", "bp-resume-all"],
      "help": "Resume all paused breakpoints",
      "usage": "bp.resume-all",
      "examples": ["bp.resume-all", "bp-resume-all"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "resume",
      "targetId": "diagnostics.breakpoints",
      "action": "resumeAll"
    },
    {
      "name": "hook.list",
      "aliases": ["hook.ls", "hook-list"],
      "help": "List hooks",
      "usage": "hook.list",
      "examples": ["hook.list", "hook-list"],
      "transport": "diagnostics",
      "category": "query",
      "operation": "list",
      "targetId": "diagnostics.hooks",
      "action": "list"
    },
    {
      "name": "hook.enable",
      "aliases": ["hook.on", "hook-enable"],
      "help": "Attach hook",
      "usage": "hook.enable <id>",
      "examples": ["hook.enable hk-001", "hook-enable hk-001"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "enable",
      "targetId": "diagnostics.hooks",
      "action": "attach",
      "params": {
        "id": { "type": "string", "position": 0, "required": true }
      }
    },
    {
      "name": "hook.disable",
      "aliases": ["hook.off", "hook-disable"],
      "help": "Detach hook",
      "usage": "hook.disable <id>",
      "examples": ["hook.disable hk-001", "hook-disable hk-001"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "disable",
      "targetId": "diagnostics.hooks",
      "action": "detach",
      "params": {
        "id": { "type": "string", "position": 0, "required": true }
      }
    },
    {
      "name": "reg.list",
      "aliases": ["reg.ls", "reg-list"],
      "help": "List registry entries",
      "usage": "reg.list [kind]",
      "examples": ["reg.list", "reg-list breakpoints"],
      "transport": "diagnostics",
      "category": "query",
      "operation": "list",
      "targetId": "diagnostics.registry",
      "action": "list",
      "params": {
        "kind": { "type": "string", "position": 0, "required": false, "default": "all" }
      }
    },
    {
      "name": "ref.get",
      "aliases": ["ref-get"],
      "help": "Read reflected member",
      "usage": "ref.get <targetId> <member>",
      "examples": ["ref.get diagnostics.monitor IsRunning", "ref-get runtime.state CurrentState"],
      "transport": "diagnostics",
      "category": "query",
      "operation": "get",
      "action": "get",
      "params": {
        "targetId": { "type": "string", "position": 0, "required": true },
        "member": { "type": "string", "position": 1, "required": true }
      }
    },
    {
      "name": "ref.set",
      "aliases": ["ref-set"],
      "help": "Set reflected member",
      "usage": "ref.set <targetId> <member> <value>",
      "examples": ["ref.set diagnostics.selftest Counter 2", "ref-set runtime.state CurrentState Working"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "set",
      "action": "set",
      "params": {
        "targetId": { "type": "string", "position": 0, "required": true },
        "member": { "type": "string", "position": 1, "required": true },
        "value": { "type": "string", "position": 2, "required": true }
      }
    },
    {
      "name": "ref.exec",
      "aliases": ["ref.x", "ref-exec"],
      "help": "Invoke whitelisted method",
      "usage": "ref.exec <targetId> <member>",
      "examples": ["ref.exec diagnostics.selftest Increment", "ref-exec diagnostics.selftest Reset"],
      "transport": "diagnostics",
      "category": "instruction",
      "operation": "invoke",
      "action": "invoke",
      "params": {
        "targetId": { "type": "string", "position": 0, "required": true },
        "member": { "type": "string", "position": 1, "required": true }
      }
    },
    {
      "name": "ref.nav",
      "aliases": ["ref.navigate", "ref-nav"],
      "help": "Navigate object path",
      "usage": "ref.nav <targetId> <member>",
      "examples": ["ref.nav diagnostics.monitor PipeName", "ref-nav runtime.execution Snapshot"],
      "transport": "diagnostics",
      "category": "query",
      "operation": "navigate",
      "action": "navigate",
      "params": {
        "targetId": { "type": "string", "position": 0, "required": true },
        "member": { "type": "string", "position": 1, "required": true }
      }
    },
    {
      "name": "host.list",
      "aliases": ["host.ls", "host-list"],
      "help": "List runtime targets",
      "usage": "host.list",
      "examples": ["host.list", "host-list"],
      "transport": "diagnostics",
      "category": "query",
      "operation": "list",
      "action": "list"
    },
    {
      "name": "host.info",
      "aliases": ["host.i", "host-info"],
      "help": "Read host scan",
      "usage": "host.info",
      "examples": ["host.info", "host-info"],
      "transport": "diagnostics",
      "category": "query",
      "operation": "inspect",
      "action": "host"
    },
    {
      "name": "host.events",
      "aliases": ["host.e", "host-events"],
      "help": "Drain events",
      "usage": "host.events [count]",
      "examples": ["host.events", "host-events 20"],
      "transport": "diagnostics",
      "category": "stream",
      "operation": "pull",
      "action": "events",
      "params": {
        "count": { "type": "int", "position": 0, "required": false, "default": "100" }
      }
    },
    {
      "name": "host.stop",
      "aliases": ["host.halt", "host-stop"],
      "help": "Shutdown host",
      "usage": "host.stop",
      "examples": ["host.stop", "host-stop"],
      "transport": "diagnostics",
      "category": "system",
      "operation": "shutdown",
      "targetId": "diagnostics.switchboard",
      "action": "shutdown"
    }
  ],
  "compositeCommands": [
    {
      "name": "status",
      "aliases": ["st"],
      "help": "Host + switchboard + target summary",
      "mode": "sequential",
      "steps": [
        { "command": "host.info" },
        { "command": "sw.list" },
        { "command": "host.list" }
      ]
    },
    {
      "name": "focus",
      "aliases": ["f"],
      "help": "Enable pipe + section + one point + global",
      "mode": "sequential",
      "params": {
        "id": { "type": "string", "position": 0, "required": true },
        "section": { "type": "string", "from": "memory", "key": "section" }
      },
      "steps": [
        { "command": "sw.pipe true" },
        { "command": "sw.enable $section" },
        { "command": "sw.point.enable $id" },
        { "command": "sw.enable" }
      ]
    },
    {
      "name": "mute",
      "aliases": ["q"],
      "help": "Disable global and all outputs",
      "mode": "sequential",
      "steps": [
        { "command": "sw.disable", "skipOnError": true },
        { "command": "sw.pipe false", "skipOnError": true },
        { "command": "sw.file false", "skipOnError": true }
      ]
    },
    {
      "name": "safe-shutdown",
      "aliases": ["ssd"],
      "help": "Resume all breakpoints then stop host",
      "mode": "sequential",
      "steps": [
        { "command": "bp.resume-all" },
        { "command": "host.stop", "delay": 300 }
      ]
    }
  ]
}
