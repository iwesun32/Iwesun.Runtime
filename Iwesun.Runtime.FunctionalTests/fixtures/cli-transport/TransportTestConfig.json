{
  "schema": "iwesun.runtime.cli/3.0",
  "application": {
    "name": "CLI transport test",
    "description": "Functional transport error fixture"
  },
  "endpoints": {
    "diagnostics": {
      "transport": "namedPipe",
      "pipeName": "unused",
      "connectTimeoutMs": 100,
      "requestTimeoutMs": 500,
      "maxResponseBytes": 1048576
    }
  },
  "commands": [
    {
      "name": "host.info",
      "endpoint": "diagnostics",
      "request": {
        "category": "query",
        "operation": "get",
        "domain": "host",
        "target": "runtime.host",
        "action": "info"
      }
    }
  ],
  "composites": [],
  "extensions": {}
}
