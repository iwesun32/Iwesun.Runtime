<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <OutputName>Iwesun.Runtime.Setup</OutputName>
    <OutputPath>..\artifacts\setup\</OutputPath>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.20</ProductVersion>
    <DefineConstants>ReleaseAppRoot=$(MSBuildThisFileDirectory)..\artifacts\release\Iwesun.Runtime\app;ReleaseDataRoot=$(MSBuildThisFileDirectory)..\artifacts\release\Iwesun.Runtime\data;ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
</Project>
