{
  "schema": "iwesun.runtime.cli/3.0",
  "application": {
    "name": "CLI transport test",
    "description": "Functional transport error fixture"
  },
  "endpoints": {
    "diagnostics": {
      "transport": "namedPipe",
      "pipeName": "unused",
      "connectTimeoutMs": 100,
      "requestTimeoutMs": 5000,
      "maxResponseBytes": 2097152
    }
  },
  "nodes": { "local": { "serverName": "." } },
  "targets": {
    "multi-a": { "node": "local", "endpoint": "diagnostics", "pipeName": "Iwesun.Runtime.Tests.MultiA" },
    "multi-b": { "node": "local", "endpoint": "diagnostics", "pipeName": "Iwesun.Runtime.Tests.MultiB" }
  },
  "commands": [
    {
      "name": "host.info",
      "endpoint": "diagnostics",
      "request": {
        "category": "query",
        "operation": "get",
        "domain": "host",
        "target": "runtime.host",
        "action": "info"
      }
    },
    {
      "name": "lifecycle.shutdown",
      "endpoint": "diagnostics",
      "request": {
        "category": "instruction",
        "operation": "shutdown",
        "domain": "lifecycle",
        "target": "diagnostics.switchboard",
        "action": "shutdown"
      }
    }
  ],
  "composites": [],
  "extensions": {}
}
