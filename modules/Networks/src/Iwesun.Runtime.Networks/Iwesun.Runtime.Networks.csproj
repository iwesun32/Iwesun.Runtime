<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <RootNamespace>Iwesun.Runtime.Networks</RootNamespace>
    <AssemblyName>Iwesun.Runtime.Networks</AssemblyName>
    <Title>Iwesun.Runtime.Networks</Title>
    <PackageId>Iwesun.Runtime.Networks</PackageId>
    <Version>3.0.0-beta.4</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <InformationalVersion>3.0.0-beta.4</InformationalVersion>
    <Authors>iwesun32</Authors>
    <Description>Value-oriented FIFO network endpoints with four-level GUID tracking, explicit access plans, branch evidence, and bounded attempts for .NET 10.</Description>
    <PackageTags>network;fifo;doh;dns;ping;icmp;precision-routing;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/iwesun32/Iwesun.Runtime</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iwesun32/Iwesun.Runtime.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Networks 3.0 beta.4: explicit IPv4/IPv6 byte factories, corrected ICMPv6 ABI parsing, request-level concurrent starts with immutable route snapshots, bounded HTTP/DoH connection pools, and UTF-8 span parsing/formatting.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="\" Link="CHANGELOG.md" />
    <None Include="..\..\docs\RELEASE_STATUS.md" Pack="true" PackagePath="docs\RELEASE_STATUS.md" Link="docs\RELEASE_STATUS.md" />
    <None Include="..\..\docs\01-design\**\*.md" Pack="true" PackagePath="docs\01-design\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\docs\02-endpoints\**\*.md" Pack="true" PackagePath="docs\02-endpoints\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\docs\03-reference\**\*.md" Pack="true" PackagePath="docs\03-reference\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\samples\Iwesun.Runtime.Networks.Examples\README.md" Pack="true" PackagePath="examples\README.md" />
  </ItemGroup>

</Project>
