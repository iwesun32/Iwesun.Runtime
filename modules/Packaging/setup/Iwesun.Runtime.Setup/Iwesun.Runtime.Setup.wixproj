<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <OutputType>Package</OutputType>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x86;x64</Platforms>
    <Platform>x64</Platform>
    <OutputName>Iwesun.Runtime.Setup</OutputName>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\..\..\..\</RepositoryRoot>
    <OutputPath>$(RepositoryRoot)artifacts\setup\</OutputPath>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.47</ProductVersion>
    <ProductCode Condition="'$(ProductCode)' == ''">FB1DB6E6-7292-2548-AA8D-33F74240788D</ProductCode>
    <DefineConstants>ReleaseAppRoot=$(RepositoryRoot)artifacts\release\Iwesun.Runtime\app;ReleaseDataRoot=$(RepositoryRoot)artifacts\release\Iwesun.Runtime\data;ProductVersion=$(ProductVersion);ProductCode=$(ProductCode)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
