<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <RootNamespace>Iwesun.Runtime.Web</RootNamespace>
    <AssemblyName>Iwesun.Runtime.Web</AssemblyName>
    <Description>Shared HTML, SVG, layout, property-slot, and audit foundations.</Description>
    <IwesunRuntimeRoot Condition="'$(IwesunRuntimeRoot)' == ''">C:\Program Files\Iwesun\Runtime</IwesunRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" GeneratePathProperty="true" ExcludeAssets="all" />
    <Reference Include="Microsoft.Web.WebView2.Core" HintPath="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\WebView2\src\Iwesun.Runtime.WebView2\Iwesun.Runtime.WebView2.csproj" />
  </ItemGroup>
</Project>
