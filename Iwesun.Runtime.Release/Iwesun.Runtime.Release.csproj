<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU;x64</Platforms>
    <ReleaseRoot>$(MSBuildThisFileDirectory)..\artifacts\release\Iwesun.Runtime\</ReleaseRoot>
    <ReleaseAppRoot>$(ReleaseRoot)app\</ReleaseAppRoot>
    <ReleaseDataRoot>$(ReleaseRoot)data\</ReleaseDataRoot>
    <ReleaseBinRoot>$(ReleaseAppRoot)bin\</ReleaseBinRoot>
    <ReleaseLibRoot>$(ReleaseAppRoot)lib\</ReleaseLibRoot>
    <ReleaseDocsRoot>$(ReleaseAppRoot)docs\</ReleaseDocsRoot>
    <ReleaseConfigRoot>$(ReleaseDataRoot)config\</ReleaseConfigRoot>
    <ReleaseSamplesRoot>$(ReleaseAppRoot)samples\</ReleaseSamplesRoot>
    <ReleaseScriptsRoot>$(ReleaseAppRoot)scripts\</ReleaseScriptsRoot>
    <ReleaseSkillsRoot>$(ReleaseAppRoot)skills\iwesun-runtime-integration\</ReleaseSkillsRoot>
    <ReleaseNetworksVersion>1.2.0</ReleaseNetworksVersion>
    <ReleaseNetworksVersionProperties>Version=$(ReleaseNetworksVersion);AssemblyVersion=$(ReleaseNetworksVersion).0;FileVersion=$(ReleaseNetworksVersion).0;InformationalVersion=$(ReleaseNetworksVersion)</ReleaseNetworksVersionProperties>
    <ReleaseWebViewDocsCompatibilityRoot>$(ReleaseAppRoot)Iwesun.Runtime.WebView2\docs\</ReleaseWebViewDocsCompatibilityRoot>
    <DiagnosticsVariantRoot>$(ReleaseLibRoot)Iwesun.Runtime.Diagnostics\</DiagnosticsVariantRoot>
    <ReleaseVersionProperties>Version=$(Version);AssemblyVersion=$(AssemblyVersion);FileVersion=$(FileVersion);InformationalVersion=$(InformationalVersion)</ReleaseVersionProperties>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iwesun.Runtime.Cli\Iwesun.Runtime.Cli.csproj" />
    <ProjectReference Include="..\Iwesun.Runtime.Diagnostics\Iwesun.Runtime.Diagnostics.csproj" />
    <ProjectReference Include="..\Iwesun.Runtime.Data\Iwesun.Runtime.Data.csproj" />
    <ProjectReference Include="..\Iwesun.Runtime.WebView2\Iwesun.Runtime.WebView2.csproj" />
    <ProjectReference Include="..\Iwesun.Runtime.SampleHost\Iwesun.Runtime.SampleHost.csproj" />
    <ProjectReference Include="..\Iwesun.Runtime.RemoteConsole\Iwesun.Runtime.RemoteConsole.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ReleaseDocs Include="..\docs\IWESUN_RUNTIME_USER_GUIDE.md" />
    <ReleaseDocs Include="..\docs\RELEASE_NOTES.md" />
    <ReleaseDocs Include="..\docs\IWESUN_RUNTIME_QUICK_START.md" />
    <ReleaseDocs Include="..\docs\IWESUN_RUNTIME_WINDOWS_SERVICE.md" />
    <ReleaseDocs Include="..\docs\IWESUN_RUNTIME_REMOTE_ACCESS.md" />
    <ReleaseDocs Include="..\docs\IWESUN_RUNTIME_REMOTE_CONSOLE.md" />
    <ReleaseDocs Include="..\docs\RUNTIME_DIAGNOSTICS.md" />
    <ReleaseDocs Include="..\docs\IWESUN_RUNTIME_CLI.md" />
    <ReleaseDocs Include="..\docs\RUNTIME_ROOT_DATA_STRUCTURE.md" />
    <ReleaseDocs Include="..\docs\05-runtime-tooling\DATA_PROJECT_RUNTIME_ROOT.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\WEBVIEW2_JSON_PIPE_CLI_PLAN.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\WEB_RUNTIME_CONTROL.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\WEBVIEW2_RUNTIME_CAPABILITIES.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\SCRIPT_REFLECTION_PLAN.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\WEBVIEW2_RELEASE_STATUS.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\DOM_SNAPSHOT_API.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\DATA_STREAM_MONITOR_RECORDER.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\FULL_PAGE_EVIDENCE_API.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\WEBVIEW2_1.0.30_EVIDENCE_RELEASE.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\WEBVIEW2_1.0.26_UPGRADE.md" />
    <ReleaseDocs Include="..\docs\RUNTIME_无配置文件整改方案.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\安全审计报告.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\安全审计答复报告.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\完整整改方案.md" />
    <ReleaseDocs Include="..\WebRuntime公共能力与CLI配置总说明.md" />
    <ReleaseDocs Include="..\docs\IWESUN_RUNTIME_WEBVIEW2_CLI_INTEGRATION.md" />
    <ReleaseDocs Include="..\Iwesun.Runtime.WebView2\docs\WEBVIEW2_SAMPLE_HOST.md" />
    <ReleaseRuntimeDocs Include="..\docs\**\*.md"
                        Exclude="..\docs\archive\**\*;..\docs\README.md;..\docs\IWESUN_RUNTIME_RELEASE_INDEX.md" />
    <ReleaseInstallIndex Include="..\docs\IWESUN_RUNTIME_RELEASE_INDEX.md" />
    <ReleaseDataReadme Include="..\..\Data\README.md" />
    <ReleaseDataDocs Include="..\..\Data\docs\**\*.md" />
    <ReleaseNetworksReadme Include="..\..\Networks\README.md" />
    <ReleaseNetworksDocs Include="..\..\Networks\docs\**\*.md" />
    <ReleaseNetworksExampleSources Include="..\..\Networks\Iwesun.Networks.Examples\**\*" Exclude="..\..\Networks\Iwesun.Networks.Examples\bin\**;..\..\Networks\Iwesun.Networks.Examples\obj\**" />
    <ReleaseWebViewDocsCompatibility Include="..\Iwesun.Runtime.WebView2\docs\*.md" />
    <ReleaseConfig Include="..\Iwesun.Runtime.Cli\RuntimeCliSystemConfig.json" />
    <ReleaseConfig Include="..\Iwesun.Runtime.Cli\RuntimeCliSystemMetadata.json" />
    <ReleaseConfig Include="..\Iwesun.Runtime.Cli\RuntimeCliUserConfig.example.json" />
    <ReleaseSamples Include="..\Iwesun.Runtime.SampleHost\templates\RuntimeHost.*.Template.cs.txt" />
    <ReleaseSamples Include="..\Iwesun.Runtime.SampleHost\templates\RuntimeCreation.*.Template.txt" />
    <ReleaseSampleHostSources Include="..\Iwesun.Runtime.SampleHost\*.cs" />
    <ReleaseWebViewSampleSources Include="..\Iwesun.Runtime.WebView2.SampleHost\**\*" Exclude="..\Iwesun.Runtime.WebView2.SampleHost\bin\**;..\Iwesun.Runtime.WebView2.SampleHost\obj\**" />
    <ReleaseInstalledSampleProject Include="..\Iwesun.Runtime.SampleHost\installed\Iwesun.Runtime.SampleHost.Installed.csproj" />
    <ReleaseSources Include="..\Iwesun.Runtime.Diagnostics\RuntimeHostTemplate.cs" />
    <ReleaseSkills Include="..\skills\iwesun-runtime-integration\**\*.*" />
    <ReleaseScripts Include="..\scripts\release\verify-runtime-install.ps1" />
    <ReleaseScripts Include="..\scripts\release\build-runtime-setup.ps1" />
  </ItemGroup>

  <Target Name="PublishRuntimeRelease">
    <RemoveDir Directories="$(ReleaseRoot)" />
    <MakeDir Directories="$(ReleaseRoot)" />
    <MakeDir Directories="$(ReleaseBinRoot)Iwesun.Runtime.Cli" />
    <MakeDir Directories="$(ReleaseLibRoot)Iwesun.Runtime.Diagnostics" />
    <MakeDir Directories="$(ReleaseLibRoot)Iwesun.Runtime.Data" />
    <MakeDir Directories="$(ReleaseLibRoot)Iwesun.Networks" />
    <MakeDir Directories="$(ReleaseLibRoot)Iwesun.Runtime.WebView2" />
    <MakeDir Directories="$(ReleaseBinRoot)Iwesun.Runtime.RemoteConsole" />
    <MakeDir Directories="$(ReleaseBinRoot)Iwesun.Runtime.SampleHost" />
    <MakeDir Directories="$(ReleaseBinRoot)Iwesun.Runtime.WebView2.SampleHost" />
    <MakeDir Directories="$(ReleaseDocsRoot)" />
    <MakeDir Directories="$(ReleaseDocsRoot)Iwesun.Runtime.Data" />
    <MakeDir Directories="$(ReleaseDocsRoot)Iwesun.Networks" />
    <MakeDir Directories="$(ReleaseWebViewDocsCompatibilityRoot)" />
    <MakeDir Directories="$(ReleaseConfigRoot)" />
    <MakeDir Directories="$(ReleaseSamplesRoot)templates" />
    <MakeDir Directories="$(ReleaseScriptsRoot)" />
    <MakeDir Directories="$(ReleaseSkillsRoot)" />
    <MakeDir Directories="$(DiagnosticsVariantRoot)Debug" />
    <MakeDir Directories="$(DiagnosticsVariantRoot)Release" />
    <MakeDir Directories="$(ReleaseSamplesRoot)source" />
    <MakeDir Directories="$(ReleaseSamplesRoot)source\Iwesun.Runtime.SampleHost\installed" />
    <MakeDir Directories="$(ReleaseSamplesRoot)source\Iwesun.Networks.Examples" />

    <MSBuild Projects="..\Iwesun.Runtime.RemoteConsole\Iwesun.Runtime.RemoteConsole.csproj"
             Targets="Publish"
             Properties="$(ReleaseVersionProperties);Configuration=$(Configuration);RuntimeIdentifier=win-x64;PublishDir=$(ReleaseBinRoot)Iwesun.Runtime.RemoteConsole\;SelfContained=false;UseAppHost=true" />
    <MSBuild Projects="..\Iwesun.Runtime.Cli\Iwesun.Runtime.Cli.csproj"
             Targets="Publish"
             Properties="$(ReleaseVersionProperties);Configuration=$(Configuration);PublishDir=$(ReleaseBinRoot)Iwesun.Runtime.Cli\;SelfContained=false;UseAppHost=true" />
    <MSBuild Projects="..\Iwesun.Runtime.SampleHost\Iwesun.Runtime.SampleHost.csproj"
             Targets="Publish"
             Properties="$(ReleaseVersionProperties);Configuration=$(Configuration);PublishDir=$(ReleaseBinRoot)Iwesun.Runtime.SampleHost\;SelfContained=false;UseAppHost=true" />
    <MSBuild Projects="..\Iwesun.Runtime.WebView2.SampleHost\Iwesun.Runtime.WebView2.SampleHost.csproj"
             Targets="Publish"
             Properties="$(ReleaseVersionProperties);Configuration=$(Configuration);PublishDir=$(ReleaseBinRoot)Iwesun.Runtime.WebView2.SampleHost\;SelfContained=false;UseAppHost=true" />
    <MSBuild Projects="..\Iwesun.Runtime.Diagnostics\Iwesun.Runtime.Diagnostics.csproj"
             Targets="Publish"
             Properties="$(ReleaseVersionProperties);Configuration=$(Configuration);PublishDir=$(ReleaseLibRoot)Iwesun.Runtime.Diagnostics\;SelfContained=false" />
    <MSBuild Projects="..\Iwesun.Runtime.Diagnostics\Iwesun.Runtime.Diagnostics.csproj"
             Targets="Publish"
             Properties="$(ReleaseVersionProperties);Configuration=Debug;PublishDir=$(DiagnosticsVariantRoot)Debug\;SelfContained=false" />
    <MSBuild Projects="..\Iwesun.Runtime.Diagnostics\Iwesun.Runtime.Diagnostics.csproj"
             Targets="Publish"
             Properties="$(ReleaseVersionProperties);Configuration=Release;PublishDir=$(DiagnosticsVariantRoot)Release\;SelfContained=false" />
    <MSBuild Projects="..\Iwesun.Runtime.Data\Iwesun.Runtime.Data.csproj"
             Targets="Publish"
             Properties="$(ReleaseVersionProperties);Configuration=$(Configuration);PublishDir=$(ReleaseLibRoot)Iwesun.Runtime.Data\;SelfContained=false" />
    <MSBuild Projects="..\..\Networks\Iwesun.Networks\Iwesun.Networks.csproj"
             Targets="Publish"
             Properties="$(ReleaseNetworksVersionProperties);Configuration=$(Configuration);PublishDir=$(ReleaseLibRoot)Iwesun.Networks\;SelfContained=false" />
    <MSBuild Projects="..\Iwesun.Runtime.WebView2\Iwesun.Runtime.WebView2.csproj"
             Targets="Publish"
             Properties="$(ReleaseVersionProperties);Configuration=$(Configuration);PublishDir=$(ReleaseLibRoot)Iwesun.Runtime.WebView2\;SelfContained=false" />

    <ItemGroup>
      <RedundantRecordStoreCopy Include="$(ReleaseLibRoot)Iwesun.Runtime.Diagnostics\Iwesun.Runtime.Data.dll" />
      <RedundantRecordStoreCopy Include="$(DiagnosticsVariantRoot)Debug\Iwesun.Runtime.Data.dll" />
      <RedundantRecordStoreCopy Include="$(DiagnosticsVariantRoot)Release\Iwesun.Runtime.Data.dll" />
      <RedundantRecordStoreCopy Include="$(ReleaseLibRoot)Iwesun.Runtime.WebView2\Iwesun.Runtime.Data.dll" />
    </ItemGroup>
    <Delete Files="@(RedundantRecordStoreCopy)" />

    <Copy SourceFiles="@(ReleaseDocs)"
          DestinationFiles="@(ReleaseDocs->'$(ReleaseDocsRoot)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseRuntimeDocs)"
          DestinationFiles="@(ReleaseRuntimeDocs->'$(ReleaseDocsRoot)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseInstallIndex)"
          DestinationFiles="@(ReleaseInstallIndex->'$(ReleaseDocsRoot)README.md')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseDataReadme)"
          DestinationFiles="@(ReleaseDataReadme->'$(ReleaseDocsRoot)Iwesun.Runtime.Data\README.md')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseDataDocs)"
          DestinationFiles="@(ReleaseDataDocs->'$(ReleaseDocsRoot)Iwesun.Runtime.Data\docs\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseNetworksReadme)"
          DestinationFiles="@(ReleaseNetworksReadme->'$(ReleaseDocsRoot)Iwesun.Networks\README.md')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseNetworksDocs)"
          DestinationFiles="@(ReleaseNetworksDocs->'$(ReleaseDocsRoot)Iwesun.Networks\docs\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseWebViewDocsCompatibility)"
          DestinationFiles="@(ReleaseWebViewDocsCompatibility->'$(ReleaseWebViewDocsCompatibilityRoot)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseConfig)"
          DestinationFiles="@(ReleaseConfig->'$(ReleaseConfigRoot)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseSamples)"
          DestinationFiles="@(ReleaseSamples->'$(ReleaseSamplesRoot)templates\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseScripts)"
          DestinationFiles="@(ReleaseScripts->'$(ReleaseScriptsRoot)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseSources)"
          DestinationFiles="@(ReleaseSources->'$(ReleaseSamplesRoot)source\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseSampleHostSources)"
          DestinationFiles="@(ReleaseSampleHostSources->'$(ReleaseSamplesRoot)source\Iwesun.Runtime.SampleHost\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(ReleaseSamplesRoot)source\Iwesun.Runtime.WebView2.SampleHost" />
    <Copy SourceFiles="@(ReleaseWebViewSampleSources)"
          DestinationFiles="@(ReleaseWebViewSampleSources->'$(ReleaseSamplesRoot)source\Iwesun.Runtime.WebView2.SampleHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseNetworksExampleSources)"
          DestinationFiles="@(ReleaseNetworksExampleSources->'$(ReleaseSamplesRoot)source\Iwesun.Networks.Examples\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseInstalledSampleProject)"
          DestinationFiles="@(ReleaseInstalledSampleProject->'$(ReleaseSamplesRoot)source\Iwesun.Runtime.SampleHost\installed\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReleaseSkills)"
          DestinationFiles="@(ReleaseSkills->'$(ReleaseSkillsRoot)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ReleaseBinRoot)Iwesun.Runtime.Cli\Iwesun.Runtime.Cli.exe"
          DestinationFiles="$(ReleaseBinRoot)Iwesun.Runtime.Cli\iwrt.exe" />
  </Target>

</Project>
